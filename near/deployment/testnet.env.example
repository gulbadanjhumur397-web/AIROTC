# Public testnet configuration
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_OWNER_ACCOUNT_ID=owner.testnet
NEAR_POOL_CONTRACT_ID=pool.owner.testnet
TEE_NEAR_ACCOUNT_ID=worker.owner.testnet
DEMO_BUYER_ACCOUNT_ID=buyer.testnet
DEMO_SELLER_ACCOUNT_ID=seller.testnet

# Live service addresses (fill after hosting)
PRIVACY_API_URL=https://api.example.invalid
TEE_WORKER_URL=https://worker.example.invalid
WEB_ORIGIN=https://app.example.invalid

# Verified public workload identity (fill from confidential deployment evidence)
TEE_MEASUREMENT_HASH=replace-with-64-lowercase-hex
TEE_IDENTITY_PROVISIONAL=false
TEE_ATTESTATION_VERIFIED=false
TEE_ENCRYPTION_KEY_HASH=replace-with-64-lowercase-hex
TEE_WORKER_PUBLIC_KEY=ed25519:replace-with-public-key
TEE_OPERATIONAL_KEY_PROVISIONED_IN_CVM=false
TEE_WORKER_IMAGE=registry.example.invalid/airotc-worker@sha256:replace-with-image-digest

# Contract limits in yoctoNEAR / nanoseconds
POOL_MIN_DEPOSIT_ATOMIC=1000000000000000000000
POOL_MAX_WITHDRAWAL_ATOMIC=10000000000000000000000000
POOL_WINDOW_LIMIT_ATOMIC=50000000000000000000000000
POOL_WINDOW_NS=3600000000000
POOL_ROTATION_DELAY_NS=60000000000

# Runtime secrets. Leave empty here. Provision through a secret manager/CVM encrypted environment.
NEAR_POOL_PRIVATE_KEY=
NEAR_OWNER_PRIVATE_KEY=
WORKER_BOOTSTRAP_PRIVATE_KEY=
TEE_NEAR_PRIVATE_KEY=
TEE_BOX_SECRET_KEY_B64URL=
TEE_LEDGER_KEY_B64URL=
PRIVACY_API_DATABASE_KEY_B64URL=
PRIVACY_API_HANDLE_SECRET_B64URL=

# Two independent agent processes
DEMO_BUYER_MCP_TOKEN=
DEMO_BUYER_NEAR_PRIVATE_KEY=
DEMO_BUYER_SIGNING_SEED_B64URL=
DEMO_BUYER_BOX_SECRET_B64URL=
DEMO_BUYER_BOX_KEY_ID=demo-buyer-box-v1
DEMO_SELLER_MCP_TOKEN=
DEMO_SELLER_NEAR_PRIVATE_KEY=
DEMO_SELLER_SIGNING_SEED_B64URL=
DEMO_SELLER_BOX_SECRET_B64URL=
DEMO_SELLER_BOX_KEY_ID=demo-seller-box-v1

# Reusable pool deposits and demo values
DEMO_BUYER_DEPOSIT_SECRET=
DEMO_SELLER_DEPOSIT_SECRET=
DEMO_PRICE_ATOMIC=100000000000000000000000
DEMO_BUYER_COLLATERAL_ATOMIC=20000000000000000000000
DEMO_SELLER_COLLATERAL_ATOMIC=20000000000000000000000
DEMO_BUYER_WITHDRAW_ATOMIC=1000000000000000000
DEMO_SELLER_WITHDRAW_ATOMIC=1000000000000000000
DEMO_PRODUCT_PUBLIC_LABEL=AIR OTC test API access
DEMO_PRODUCT_VALIDATION_URL=https://demo-api.example.invalid/v1/proof
DEMO_PRODUCT_SECRET=

# Evidence output is ignored by Git and must contain no secrets.
PHASE9_EVIDENCE_FILE=near/evidence/two-agent-testnet.json
