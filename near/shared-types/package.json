    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.0"
  }
}
