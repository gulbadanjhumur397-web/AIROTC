NODE_ENV=production
HOST=0.0.0.0
PORT=8080

NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_POOL_CONTRACT_ID=replace-with-pool-account.testnet
TEE_NEAR_ACCOUNT_ID=replace-with-worker-account.testnet
TEE_NEAR_PRIVATE_KEY=ed25519:replace-with-secret-from-attested-provisioning

TEE_ENCRYPTION_KEY_ID=airotc-tee-key-v1
TEE_BOX_SECRET_KEY_B64URL=replace-with-32-byte-base64url-secret
TEE_LEDGER_KEY_B64URL=replace-with-independent-32-byte-base64url-secret
TEE_LEDGER_PATH=/var/lib/airotc/ledger.snapshot
TEE_MAINTENANCE_INTERVAL_MS=15000
DSTACK_SOCKET_PATH=/var/run/dstack.sock

# Local development only. Production startup rejects this setting.
ALLOW_UNVERIFIED_DEV_ATTESTATION=false

